# ==============================================================
# Konfigurasi Lingkungan (Environment Variables) - Kalkulator Duitmu
# Salin file ini menjadi '.env' di folder utama proyek
# ==============================================================

# 1. URL Server Backend Python (REST API)
# Jika menjalankan server Python lokal: http://localhost:8000
# Jika menggunakan server produksi di Vercel: kosongkan atau arahkan ke domain Anda
VITE_PYTHON_API_URL=http://localhost:8000

# 2. Basis Data MySQL (digunakan oleh server backend Python)
# Format: mysql+pymysql://<user>:<password>@<host>:<port>/<nama_database>
DATABASE_URL=mysql+pymysql://root:@localhost:3306/kalkulator_duit

# 3. Konfigurasi Cloud Supabase (Opsi Sinkronisasi Cadangan)
VITE_SUPABASE_URL=https://proyek-anda.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 4. Pengaturan Hak Akses Admin
VITE_ADMIN_USERNAME=pemilik
