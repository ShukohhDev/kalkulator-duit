# ==============================================================
# Konfigurasi Lingkungan Server Python
# Salin file ini menjadi '.env' di dalam folder server_python/
# ==============================================================

# Port Server API
PORT=8000

# Rahasia Token JWT (Ganti dengan kata acak Anda sendiri untuk produksi)
